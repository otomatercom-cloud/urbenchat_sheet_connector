<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_urbenchat_test_connection_wizard_form" model="ir.ui.view">
        <field name="name">urbenchat.test.connection.wizard.form</field>
        <field name="model">urbenchat.test.connection.wizard</field>
        <field name="arch" type="xml">
            <form string="Test Connection Result">
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="config_id" invisible="1"/>

                    <!-- Banners -->
                    <div class="alert alert-success mb-3" role="alert"
                         invisible="state != 'ok'">
                        <strong>✅ All checks passed!</strong>
                        Sheet is reachable and columns are mapped. Ready to Sync Now.
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="state != 'error' or error_message != False">
                        <strong>⚠️ Some checks failed.</strong>
                        Review each tab — items marked ❌ need to be fixed before syncing.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="state != 'error' or not error_message">
                        <strong>❌ Could not connect to the sheet.</strong>
                    </div>

                    <!-- Connection error -->
                    <group string="Error Detail" invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1" widget="text"
                               style="font-family:monospace;font-size:12px;color:#dc3545;"/>
                    </group>

                    <!-- Sheet info row -->
                    <div class="row mb-3" invisible="not sheet_headers_raw">
                        <div class="col-8">
                            <div class="o_form_label fw-bold mb-1">📋 Detected Sheet Headers</div>
                            <div style="font-family:monospace;font-size:12px;
                                        background:#f8f9fa;border:1px solid #dee2e6;
                                        border-radius:6px;padding:10px;
                                        word-break:break-all;line-height:1.8;">
                                <field name="sheet_headers_raw" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="o_form_label fw-bold mb-1">📊 Sheet Stats</div>
                            <div style="background:#f8f9fa;border:1px solid #dee2e6;
                                        border-radius:6px;padding:10px;">
                                <div style="font-size:32px;font-weight:800;color:#6366f1;text-align:center;">
                                    <field name="rows_fetched" readonly="1" nolabel="1"
                                           style="display:inline;"/>
                                </div>
                                <div style="font-size:12px;color:#64748b;text-align:center;">
                                    Total Rows in Sheet
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tabs -->
                    <notebook invisible="not sheet_headers_raw">

                        <page string="1 · Column Mapping" name="col_check">
                            <field name="mapping_status" readonly="1" nolabel="1" widget="text"
                                   style="font-family:monospace;font-size:12px;
                                          white-space:pre;min-height:150px;
                                          background:#f8fafc;border:1px solid #e2e8f0;
                                          border-radius:6px;padding:12px;"/>
                            <div class="mt-2" style="font-size:11px;color:#64748b;">
                                ✅ column found and mapped correctly &#160;|&#160;
                                ❌ NOT found — fix the name in Column Mapping tab &#160;|&#160;
                                ⚪ in sheet but not mapped (ignored)
                            </div>
                        </page>

                        <page string="2 · Ad ID Mapping" name="ad_check">
                            <field name="ad_id_check" readonly="1" nolabel="1" widget="text"
                                   style="font-family:monospace;font-size:12px;
                                          white-space:pre;min-height:120px;
                                          background:#f8fafc;border:1px solid #e2e8f0;
                                          border-radius:6px;padding:12px;"/>
                            <div class="mt-2" style="font-size:11px;color:#64748b;">
                                ✅ Ad ID mapped to a campaign &#160;|&#160;
                                ❌ Add this Ad ID in Ads Manager → Meta Ad Mapping → Import from Excel
                            </div>
                        </page>

                        <page string="3 · Officer Names" name="officer_check">
                            <field name="officer_check" readonly="1" nolabel="1" widget="text"
                                   style="font-family:monospace;font-size:12px;
                                          white-space:pre;min-height:100px;
                                          background:#f8fafc;border:1px solid #e2e8f0;
                                          border-radius:6px;padding:12px;"/>
                            <div class="mt-2" style="font-size:11px;color:#64748b;">
                                ✅ officer found in Employees — will be assigned &#160;|&#160;
                                ❌ not found — lead created without officer
                            </div>
                        </page>

                        <page string="4 · Sample Data" name="preview">
                            <field name="sample_preview" readonly="1" nolabel="1" widget="text"
                                   style="font-family:monospace;font-size:12px;
                                          white-space:pre;min-height:120px;
                                          background:#f8fafc;border:1px solid #e2e8f0;
                                          border-radius:6px;padding:12px;"/>
                        </page>

                    </notebook>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
