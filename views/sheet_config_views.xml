<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tree View ─────────────────────────────────────────────────── -->
    <record id="view_urbenchat_sheet_config_tree" model="ir.ui.view">
        <field name="name">urbenchat.sheet.config.tree</field>
        <field name="model">urbenchat.sheet.config</field>
        <field name="arch" type="xml">
            <tree string="Sheet Configurations">
                <field name="name"/>
                <field name="auth_method"/>
                <field name="sheet_id"/>
                <field name="last_sync_date"/>
                <field name="total_leads_created"/>
                <field name="last_sync_created"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────── -->
    <record id="view_urbenchat_sheet_config_form" model="ir.ui.view">
        <field name="name">urbenchat.sheet.config.form</field>
        <field name="model">urbenchat.sheet.config</field>
        <field name="arch" type="xml">
            <form string="Sheet Configuration">
                <header>
                    <button name="action_test_connection" string="🔌 Test Connection"
                            type="object" class="btn-secondary"/>
                    <button name="action_sync_now" string="⟳  Sync Now"
                            type="object" class="btn-primary"/>
                    <button name="action_view_logs" string="Sync Logs"
                            type="object" class="btn-secondary"/>
                    <button name="action_purge_old_logs" string="🗑 Purge Old Logs"
                            type="object" class="btn-secondary"
                            confirm="Delete all sync logs older than the last 30? This frees up database space."/>
                    <button name="action_reset_sync_tracking" string="↺ Reset Tracking"
                            type="object" class="btn-secondary"
                            confirm="This clears all processed row records. Next sync will re-process the full sheet from the beginning. Continue?"/>
                    <button name="action_dedupe_re_enquiries" string="🧹 Dedupe Re-Enquiries"
                            type="object" class="btn-danger"
                            confirm="This permanently deletes duplicate Re-Enquiry records (same lead + same New Source), keeping only the earliest one in each group, system-wide across all sheet configs. This cannot be undone. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. UrbanChat Meta Leads"/></h1>
                    </div>

                    <!-- Stats row -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="sync_log_count" widget="statinfo" string="Sync Logs"/>
                        </button>
                        <div class="oe_stat_button" icon="fa-users">
                            <field name="total_leads_created" widget="statinfo" string="Total Created"/>
                        </div>
                        <div class="oe_stat_button" icon="fa-check-circle">
                            <field name="synced_record_count" widget="statinfo" string="Rows Tracked"/>
                        </div>
                    </div>

                    <notebook>

                        <!-- ══ Tab 1 · Connection ═════════════════════════ -->
                        <page string="Connection" name="connection">
                            <group>
                                <group string="Google Sheet">
                                    <field name="sheet_url" widget="url"
                                           placeholder="https://docs.google.com/spreadsheets/d/…"/>
                                    <field name="sheet_id" readonly="1"/>
                                    <field name="gid"
                                           help="The gid= value in your sheet URL for the correct tab. Default 0 = first tab."/>
                                    <field name="skip_header_rows"/>
                                    <field name="sync_interval_minutes"
                                           help="How often this sheet is auto-synced. Default 5 min. Minimum 1 min."/>
                                    <field name="next_sync_date" readonly="1"/>
                                    <field name="active"/>
                                </group>
                                <group string="Authentication">
                                    <field name="auth_method" widget="radio"/>
                                    <field name="service_account_json" widget="text"
                                           invisible="auth_method != 'service_account'"
                                           placeholder="Paste the full JSON content of your Google service account key file…"/>
                                </group>
                            </group>
                        </page>

                        <!-- ══ Tab 2 · Column Mapping ═════════════════════ -->
                        <page string="Column Mapping" name="columns">
                            <div class="alert alert-info" role="alert">
                                <strong>How to fill this table:</strong>
                                Open your Google Sheet → look at <strong>Row 1</strong> (the header row).
                                Copy each column header name exactly (case-sensitive) into the
                                <em>Sheet Column Header</em> column, then pick the matching
                                <em>Lead Field</em> from the dropdown.
                                Tick <em>Required?</em> for columns that must have a value
                                (rows with empty required columns are skipped).
                                Use <em>Default Value</em> to fill in a fixed value when the
                                sheet cell is blank.
                            </div>
                            <field name="column_mapping_ids">
                                <tree editable="bottom" string="Column Mappings">
                                    <field name="sequence" widget="handle"/>
                                    <field name="sheet_column"
                                           placeholder="Exact header from sheet…"/>
                                    <field name="lead_field"/>
                                    <field name="lead_field_label" optional="show" readonly="1"
                                           string="Maps To (label)"/>
                                    <field name="is_required"/>
                                    <field name="default_value" optional="show"
                                           placeholder="Leave blank if not needed"/>
                                    <field name="note" optional="show"
                                           placeholder="Internal note…"/>
                                </tree>
                            </field>

                            <!-- Quick reference card -->
                            <div class="mt-3 p-3 border rounded bg-light">
                                <strong>Common UrbanChat sheet headers (check yours):</strong>
                                <table class="table table-sm mt-2" style="font-size:12px;">
                                    <thead>
                                        <tr>
                                            <th>Typical Sheet Header</th>
                                            <th>Lead Field to pick</th>
                                            <th>Required?</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td><code>Nam</code></td><td>👤 Lead Name</td><td>✅</td></tr>
                                        <tr><td><code>Phone</code></td><td>📱 Mobile / Phone</td><td>✅</td></tr>
                                        <tr><td><code>Email</code></td><td>📧 Email</td><td>—</td></tr>
                                        <tr><td><code>Ad Id</code></td><td>🔖 Ad ID (for campaign auto-map)</td><td>—</td></tr>
                                        <tr><td><code>Interested Course</code></td><td>📚 Course (matched by name)</td><td>—</td></tr>
                                        <tr><td><code>Location</code></td><td>🏫 College / School</td><td>—</td></tr>
                                        <tr><td><code>Conversation Assigned to</code></td><td>🧑‍💼 Admission Officer (matched by name)</td><td>—</td></tr>
                                        <tr><td><code>Date</code></td><td>🕐 Timestamp (filter only)</td><td>—</td></tr>
                                        <tr><td><code>User Id</code></td><td>🔑 Unique Key (dedup only)</td><td>—</td></tr>
                                        <tr><td><code>Channel</code></td><td>📡 Incoming Source</td><td>—</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </page>

                        <!-- ══ Tab 3 · Lead Defaults ══════════════════════ -->
                        <page string="Lead Defaults" name="defaults">
                            <group>
                                <group>
                                    <field name="default_leads_source_id"
                                           help="Used when no Ad ID mapping matches a row. Required if Ad ID column is absent."/>
                                    <field name="default_lead_quality"/>
                                </group>
                            </group>
                        </page>

                        <!-- ══ Tab 4 · Sync History ═══════════════════════ -->
                        <page string="Sync History" name="sync_history">
                            <field name="sync_log_ids" readonly="1">
                                <tree>
                                    <field name="sync_date"/>
                                    <field name="triggered_by"/>
                                    <field name="rows_fetched"/>
                                    <field name="leads_created"/>
                                    <field name="leads_skipped" string="Re-Enquiries"/>
                                    <field name="leads_error"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state=='success'"
                                           decoration-warning="state=='partial'"
                                           decoration-danger="state=='failed'"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_urbenchat_sheet_config" model="ir.actions.act_window">
        <field name="name">Sheet Configurations</field>
        <field name="res_model">urbenchat.sheet.config</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
